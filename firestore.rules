rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'priyaparmar7030@gmail.com');
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'priyaparmar7030@gmail.com');
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn() || isValidId(orderId);
      allow create: if isValidId(orderId);
      allow update, delete: if isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com';
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com';
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com';
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if (isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com')
        || isValidId(customerId);
      allow create: if isValidId(customerId)
        && incoming().customerId == customerId
        && incoming().role == 'customer'
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 150))
        && !('password' in incoming())
        && !('plainPassword' in incoming())
        && !('customerPassword' in incoming())
        && !('passwordHash' in incoming())
        && !('passwordSalt' in incoming());
      allow update: if (isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com')
        || (isValidId(customerId)
            && incoming().customerId == existing().customerId
            && incoming().role == existing().role
            && !('password' in incoming())
            && !('plainPassword' in incoming())
            && !('customerPassword' in incoming())
            && !('passwordHash' in incoming())
            && !('passwordSalt' in incoming()));
      allow delete: if isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com';
    }

    // Encrypted Customer Auth Credentials
    match /customer_auth/{customerId} {
      allow read: if isValidId(customerId);
      allow create: if isValidId(customerId)
        && incoming().customerId == customerId
        && incoming().encryptedData is string
        && incoming().encryptedData.size() <= 2048;
      allow update: if isValidId(customerId)
        && incoming().customerId == existing().customerId
        && incoming().encryptedData is string
        && incoming().encryptedData.size() <= 2048;
      allow delete: if isSignedIn() && request.auth.token.email == 'priyaparmar7030@gmail.com';
    }

    // Prakriti Loyalty Rewards Collection
    match /loyalty/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Exclusive Customer Offers Collection
    match /customer_offers/{offerId} {
      allow read: if true;
      allow write: if isValidId(offerId);
    }
  }
}
